# ==========================================
# Recon LLM Configuration
# ==========================================

# Active provider: llamacpp | openai | anthropic
LLM_PROVIDER=llamacpp
LLM_NAME=qwen3.5-4b

# ------------------------------------------
# LlamaCPP / Local llama-server Configuration
# ------------------------------------------
# Path to local GGUF model file (used by scripts/run-llm.sh)
MODEL_PATH=/path/to/model.gguf
HOST=127.0.0.1
PORT=8080
CONTEXT_SIZE=4096
GPU_LAYERS=40
THREADS=4

# Optional explicit endpoint overrides for LlamaCPP
# LLAMACPP_HOST=127.0.0.1
# LLAMACPP_PORT=8080
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMACPP_API_KEY=no-key-required
# LLAMACPP_MODEL_NAME=qwen3.5-4b

# ------------------------------------------
# OpenAI Configuration
# ------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------
# Anthropic Configuration
# ------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com
